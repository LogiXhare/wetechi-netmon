                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditEntryView": {
        "type": "object",
        "description": "One audit record.",
        "required": [
          "audit_id",
          "occurred_at",
          "actor",
          "action",
          "result"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "after": {},
          "audit_id": {
            "type": "string"
          },
          "before": {},
          "occurred_at": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "type": "string",
            "description": "allowed, denied, error."
          }
        }
      },
      "AuditPage": {
        "type": "object",
        "required": [
          "items",
          "has_more"
        ],
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntryView"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DetectionPage": {
        "type": "object",
        "required": [
          "items",
          "has_more"
        ],
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetectionView"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DetectionView": {
        "type": "object",
        "description": "One detection event linked to the incident.",
        "required": [
          "detection_event_id",
          "detection_id",
          "policy_id",
          "policy_version",
          "kind",
          "severity",
          "link_type",
          "detected_at",
          "observed_at",
          "matched",
          "rates"
        ],
        "properties": {
          "detected_at": {
            "type": "string"
          },
          "detection_event_id": {
            "type": "string"
          },
          "detection_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "started, updated, ended."
          },
          "link_type": {
            "type": "string",
            "description": "opening, update, closing, late, evidence."
          },
          "matched": {},
          "observed_at": {
            "type": "string"
          },
          "policy_id": {
            "type": "string"
          },
          "policy_version": {
            "type": "integer",
            "format": "int32"
          },
          "rates": {},
          "severity": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "`ok` or `ready`."
          }
        }
      },
      "IncidentPage": {
        "type": "object",
        "description": "A page of incidents.",
        "required": [
          "items",
          "has_more"
        ],
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IncidentSummaryView"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `cursor` for the next page; `null` on the last."
          },
          "total": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Every match, only with `include_total=true`."
          }
        }
      },
      "IncidentSummaryView": {
        "type": "object",
        "description": "One incident in a list.",
        "required": [
          "incident_id",
          "incident_number",
          "title",
          "state",
          "severity",
          "priority",
          "category",
          "direction",
          "address_family",
          "target_type",
          "target_id",
          "opened_at",
          "last_detected_at",
          "last_updated_at",
          "version"
        ],
        "properties": {
          "address_family": {
            "type": "integer",
            "format": "int32"
          },
          "assigned_team_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "assigned_user_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "incident_id": {
            "type": "string"
          },
          "incident_number": {
            "type": "string"
          },
          "last_detected_at": {
            "type": "string"
          },
          "last_updated_at": {
            "type": "string"
          },
          "opened_at": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          },
          "target_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "IncidentView": {
        "type": "object",
        "description": "One incident, as `GET /api/v1/incidents/{id}` returns it.",
        "required": [
          "incident_id",
          "incident_number",
          "schema_version",
          "tenant_id",
          "title",
          "state",
          "severity",
          "severity_source",
          "maximum_detected_severity",
          "priority",
          "category",
          "direction",
          "address_family",
          "target_type",
          "target_id",
          "correlation_key",
          "first_detected_at",
          "opened_at",
          "last_detected_at",
          "last_updated_at",
          "reopen_count",
          "policy_refs",
          "policy_refs_omitted",
