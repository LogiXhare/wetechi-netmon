{
  "openapi": "3.1.0",
  "info": {
    "title": "WetechiNetMon Incident API",
    "description": "Incident management REST API. Errors are RFC 9457 problem details with a stable `error` code.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Liveness: the process is up. Touches nothing else.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The process is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Readiness: the database answers. The API fails closed without it.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "The database answers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "`ok` or `ready`."
          }
        }
      },
      "ProblemDocument": {
        "type": "object",
        "description": "RFC 9457 problem details, as every error response carries them.",
        "required": [
          "type",
          "title",
          "status",
          "error",
          "request_id"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "error": {
            "type": "string",
            "description": "The stable machine-readable code; see `docs/api/error-codes.md`."
          },
          "request_id": {
            "type": "string",
            "description": "The UUIDv7 also returned in `X-Request-Id`."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "`https://wetechi.com/probs/` and the code, as an identifier."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "operations",
      "description": "Liveness and readiness"
    }
  ]
}
